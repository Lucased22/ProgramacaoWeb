<div class="d-flex justify-content-between align-items-center">
    <h2>Login de Usuário</h2>
    <h4><a href= "/users"><i class="bi bi-arrow-left-square"></i> </a></h4>
</div>
<form action="/users/login{{#if user}}update/{{user.id}}{{else}}create{{/if}}" method="post">
    <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input value="{{user.email}}" name="email" type="text" class="form-control" id="email" >
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Senha</label>
        <input name="password"class="form-control" id="password" rows="3"></input>
    </div>

    <button type="submit" class="btn btn-primary">Login</button>
</form>